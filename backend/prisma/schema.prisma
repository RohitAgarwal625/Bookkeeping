// Bookkeeping — Prisma schema (converged final design)
// Database: PostgreSQL (Railway)
// See: design/backend-architecture/final/architecture.html

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  piWalletAddress String        @unique
  piUsername      String?       @unique
  piUid           String?       @unique
  displayName     String        @default("Pioneer User")
  // Internal member id "BK" + 4-digit sequence (BK0001, ..., BK9999, BK10000). INTERNAL ONLY:
  // never sent to the frontend. Filled by bk_next_member_id() (sequence "User_memberId_seq",
  // migration *_in_app_payments, which also backfilled existing users in createdAt order).
  memberId        String        @unique @default(dbgenerated("bk_next_member_id()"))
  // The user's own public Pi wallet address (G..., 56 chars), entered in Settings.
  // Pi doesn't give it to apps (its /v2/user_wallets is allowlist-only), so the user types it.
  // Not to be confused with piWalletAddress above, which actually holds the Pi uid.
  // One account per address (unique; many NULLs allowed): a user is "on the app" for
  // in-app payments when some user has the address here.
  walletPublicKey String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contacts        Contact[]
  transactions    Transaction[]
  sessions        Session[]
  sentIntents     PaymentIntent[] @relation("PaymentIntentSender")
  receivedIntents PaymentIntent[] @relation("PaymentIntentReceiver")

}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Database CHECK constraints (Prisma can't express CHECK) live in the hand-written
// migration *_add_check_constraints: Contact.category IN ('individual','business');
// Transaction.amount > 0, type, source and status limited to the values listed below.
// Adding a new type/source/status/category value needs a new migration that updates them.
model Contact {
  id              String        @id @default(cuid())
  name            String
  category        String // "individual" | "business"
  piWalletAddress String
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  paymentIntents  PaymentIntent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, piWalletAddress])
}

model Transaction {
  id             String    @id @default(cuid())
  description    String
  amount         Decimal   @db.Decimal(18, 7)
  type           String // "credit" | "debit"
  source         String    @default("manual") // "manual" | "pi_network"
  txHash         String?
  piPaymentId    String?
  // Horizon payment operation id; set only on entries saved by the Automatic
  // (blockchain) scan. Unique per user, so scanning the same dates again skips
  // payments that are already in the ledger instead of adding them twice.
  chainPaymentId String?
  idempotencyKey String    @unique
  status         String    @default("completed") // pending|completed|failed|cancelled|expired
  expiresAt      DateTime?
  deletedAt      DateTime?
  timestamp      DateTime  @default(now())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, contactId])
  @@index([userId, timestamp])
  @@index([status, expiresAt])
  @@unique([userId, chainPaymentId])
}

// An in-app payment (Pay via contacts / Pay via QR) between two app users. Created before
// the sender opens the Pi Wallet; confirmed only from Horizon data (the payment op from
// senderAddress to receiverAddress), never from the client. CHECK constraints (migration
// *_in_app_payments): status in the values below, amount > 0 when set.
model PaymentIntent {
  id                    String    @id @default(cuid())
  senderId              String
  sender                User      @relation("PaymentIntentSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId            String
  receiver              User      @relation("PaymentIntentReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  senderAddress         String
  receiverAddress       String
  // Null for Pay via QR (the app doesn't know the amount); set to the chain amount on confirm.
  amount                Decimal?  @db.Decimal(18, 7)
  // The sender's contact being paid, if any.
  contactId             String?
  contact               Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status                String    @default("pending") // pending|confirmed|failed|expired|cancelled (failed = its transaction failed on the chain)
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  confirmedAt           DateTime?
  // Horizon payment operation id of the matched payment; one intent per payment.
  chainPaymentId        String?   @unique
  txHash                String?
  senderTransactionId   String?
  receiverTransactionId String?

  @@index([senderId, status])
  @@index([receiverId, status])
}
