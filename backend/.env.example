# --- Backend environment variables ---

# Railway PostgreSQL connection string.
# Append pool tuning to prevent connection exhaustion (G-013).
DATABASE_URL="postgresql://user:password@host:5432/bookkeeping?connection_limit=5&pool_timeout=10"

# Server
PORT=3001
NODE_ENV=development

# Comma-separated allowed CORS origins (frontend URLs).
CORS_ORIGIN="http://localhost:5173"

# Logging
LOG_LEVEL=info

# Pi Network Payments & Platform API
# PI_NETWORK_API_KEY is required for server-to-server payment endpoints (/approve and /complete)
# Obtain from Pi Developer Portal: develop.pi in Pi Browser -> Your App -> App Details -> Server API Key
PI_NETWORK_API_KEY=""
PI_PLATFORM_API_URL="https://api.minepi.com"
JWT_SECRET="change-me-in-phase-4"
